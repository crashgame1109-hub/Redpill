# ===== REDPILL backend — переменные окружения =====
# Скопируй этот файл в .env и заполни реальными значениями.
# .env никогда не коммить в git — там секреты.

# --- Telegram Bot ---
# Токен бота из @BotFather (например 123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
BOT_TOKEN=

# --- Crypto Pay API (@CryptoBot) ---
# Получи токен: открой @CryptoBot в Telegram → Crypto Pay → My Apps → Create App
CRYPTO_PAY_TOKEN=
# 'mainnet' для реальных денег, 'testnet' для теста (через @CryptoTestnetBot)
CRYPTO_PAY_NETWORK=mainnet

# --- Сервер ---
PORT=8080
# Публичный HTTPS-адрес ЭТОГО бэкенда (нужен для вебхуков CryptoBot и для setWebhook Telegram)
PUBLIC_URL=https://your-backend-domain.com
# Домен фронтенда (для CORS). Можно несколько через запятую.
CORS_ORIGIN=https://your-frontend-domain.com

# --- Экономика: конвертация реальных денег в игровые монеты ---
# Сколько игровых монет выдавать за 1 Telegram Star
COINS_PER_STAR=100
# Сколько игровых монет выдавать за 1 USDT (крипто-платежи)
COINS_PER_USDT=1000

# --- Секрет для вебхука Telegram (произвольная строка, чтобы отличать настоящие апдейты) ---
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string

# --- База данных ---
# Путь к файлу SQLite (создастся автоматически при первом запуске)
DB_PATH=./data/redpill.db

# --- Общий раунд (тайминги В МИЛЛИСЕКУНДАХ) ---
# ВАЖНО: должны совпадать с T_BET/T_LOCK/T_SPIN/T_RESULT в index.html,
# иначе анимация шара на клиенте разъедется с реальным моментом раскрытия исхода.
T_BET=7000
T_LOCK=700
T_SPIN=4200
T_RESULT=3000

# --- Математика раунда (та же формула, что и на клиенте) ---
RTP=0.97
BOOST_ROUNDS=7
BOOST_RTP=0.99
BET_MIN=10

# --- Вывод средств ---
# Секретный токен для /admin/withdrawals — придумай длинную случайную строку,
# это твой личный доступ к подтверждению выплат.
ADMIN_TOKEN=
# Минимальная сумма вывода в USDT — защита от спама копеечными заявками
MIN_WITHDRAWAL_USDT=2

# --- Админ-панель как отдельный сайт ---
# Необязательно: домен (без https://), на котором должна открываться панель,
# например admin.твой-домен.com. Настрой в DNS этот поддомен на тот же сервер,
# что и основную игру — переключать код или гонять два деплоя не нужно.
# Не задан — панель всё равно доступна по пути /admin-panel на основном домене.
ADMIN_HOST=

# --- Общая доска Mines (36 шариков, 3 цвета по 12, доска одна на всех) ---
MINES_T_BET=12000
MINES_T_ROUND=30000
MINES_N=36
MINES_PER_COLOR=12
MINES_MAX_DEPTH=7
